{
  "name": "@handthesia/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:m1:assets": "node tools/prepare-pyodide-runtime.mjs",
    "predev": "npm run prepare:m1:assets",
    "dev": "vite --config apps/client/vite.config.ts",
    "prebuild": "npm run prepare:m1:assets",
    "build": "vite build --config apps/client/vite.config.ts",
    "typecheck": "tsc -b apps/client/tsconfig.json && tsc -p packages/contracts/tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint --config eslint.config.js eslint.config.js vitest.config.ts playwright.config.ts apps/client packages/contracts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:parity": "playwright test --config playwright.config.ts tests/browser/parity-m1.spec.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "ci": "node tools/ci-verify.mjs",
    "archive": "pwsh tools/archive-web.ps1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
