{
  "name": "@handthesia/web",
  "version": "0.1.0-dev.6",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:m1:assets": "node tools/prepare-pyodide-runtime.mjs",
    "prepare:melodies": "node tools/prepare-builtin-melodies.mjs",
    "predev": "npm run prepare:m1:assets && npm run prepare:melodies",
    "dev": "vite --config apps/client/vite.config.ts",
    "prebuild": "npm run prepare:m1:assets",
    "build": "node tools/build-release.mjs",
    "preview": "vite preview --config apps/client/vite.config.ts",
    "typecheck": "tsc -b apps/client/tsconfig.json && tsc -p packages/contracts/tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint --config eslint.config.js eslint.config.js vitest.config.ts playwright.config.ts playwright.worker.config.ts playwright.audio.config.ts playwright.preview.config.ts playwright.media.config.ts playwright.soundfont.config.ts tools/build-release.mjs tools/generate-offline-manifest.mjs tools/prepare-builtin-melodies.mjs tools/verify-builtin-catalog.mjs tools/test-python.mjs tools/run-browser-verification.mjs tools/ci-verify.mjs apps/client packages/contracts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:python": "node tools/test-python.mjs",
    "pretest:catalog": "npm run prepare:m1:assets && npm run prepare:melodies",
    "test:catalog": "node --experimental-strip-types tools/verify-builtin-catalog.mjs",
    "test:parity": "playwright test --config playwright.worker.config.ts tests/browser/parity-m1.spec.ts",
    "test:worker": "playwright test --config playwright.worker.config.ts",
    "test:audio": "playwright test --config playwright.audio.config.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:offline": "playwright test --config playwright.preview.config.ts",
    "test:media": "playwright test --config playwright.media.config.ts",
    "test:browser:all": "node tools/run-browser-verification.mjs",
    "ci": "node tools/ci-verify.mjs",
    "archive": "pwsh tools/archive-web.ps1",
    "test:soundfont": "playwright test --config playwright.soundfont.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
